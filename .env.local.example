# Copy this file to .env.local and fill in the values.
# Supabase dashboard -> Settings -> API Keys
#
# Placeholders only. Do not commit real values here — Netlify's secret scanner
# reads repo files as well as build output and will fail the deploy.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key. Safe in the browser; it is inlined into the JS bundle.
# The build refuses to compile if a secret key is put here (src/lib/supabase.ts).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# The SECRET key. Server-only — used by the admin roster and payment tracking,
# which need to bypass Row Level Security.
#
# Note the deliberate absence of a NEXT_PUBLIC_ prefix: that prefix is what
# causes Next.js to inline a value into the browser bundle. This one must never
# have it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Password for the /admin page. Required — if unset, /admin locks itself.
# Quote it if it contains a $ (see README).
ADMIN_PASSWORD=change-me
